{
  "compilerOptions": {
    "module": "commonjs",
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist/",
    "target": "es6",
    "allowJs": true,
    "lib": ["es2019", "DOM", "ES6", "DOM.Iterable", "ScriptHost"]
  },
  "include": ["src/**/*"]
}
