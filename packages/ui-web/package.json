{
  "name": "@once/ui-web",
  "version": "0.0.0",
  "private": true,
  "description": "Shared DOM UI for Once",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "reader/readerDocument": ["dist/reader/readerDocument.d.ts"],
      "reader/readerTts": ["dist/reader/readerTts.d.ts"],
      "reader/readerPageRuntime": ["dist/reader/readerPageRuntime.d.ts"],
      "picker/sourcePicker": ["dist/picker/sourcePicker.d.ts"],
      "gesture/touchGestureLock": ["dist/gesture/touchGestureLock.d.ts"],
      "addons/conversationPage": ["dist/addons/conversationPage.d.ts"],
      "addons/pageActionHost": ["dist/addons/pageActionHost.d.ts"],
      "addons/bundledPageActions": ["dist/addons/bundledPageActions.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reader/readerDocument": {
      "types": "./dist/reader/readerDocument.d.ts",
      "default": "./dist/reader/readerDocument.js"
    },
    "./reader/readerTts": {
      "types": "./dist/reader/readerTts.d.ts",
      "default": "./dist/reader/readerTts.js"
    },
    "./gesture/touchGestureLock": {
      "types": "./dist/gesture/touchGestureLock.d.ts",
      "default": "./dist/gesture/touchGestureLock.js"
    },
    "./reader/readerPageRuntime": {
      "types": "./dist/reader/readerPageRuntime.d.ts",
      "default": "./dist/reader/readerPageRuntime.js"
    },
    "./addons/sandboxRuntime": {
      "types": "./dist/addons/sandboxRuntime.d.ts",
      "default": "./dist/addons/sandboxRuntime.js"
    },
    "./addons/conversationPage": {
      "types": "./dist/addons/conversationPage.d.ts",
      "default": "./dist/addons/conversationPage.js"
    },
    "./addons/pageActionHost": {
      "types": "./dist/addons/pageActionHost.d.ts",
      "default": "./dist/addons/pageActionHost.js"
    },
    "./addons/bundledPageActions": {
      "types": "./dist/addons/bundledPageActions.d.ts",
      "default": "./dist/addons/bundledPageActions.js"
    },
    "./picker/sourcePicker": {
      "types": "./dist/picker/sourcePicker.d.ts",
      "default": "./dist/picker/sourcePicker.js"
    }
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@once/app": "*",
    "@once/collectors": "*",
    "@once/core": "*",
    "@zip.js/zip.js": "2.8.30",
    "marked": "18.0.11"
  }
}
