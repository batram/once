{
  "name": "@once/app",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "tabsync": ["dist/tabsync/index.d.ts"],
      "tabsync/pageScripts": ["dist/tabsync/pageScripts.d.ts"],
      "browsingSite": ["dist/browsingSite.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tabsync": {
      "types": "./dist/tabsync/index.d.ts",
      "default": "./dist/tabsync/index.js"
    },
    "./tabsync/pageScripts": {
      "types": "./dist/tabsync/pageScripts.d.ts",
      "default": "./dist/tabsync/pageScripts.js"
    },
    "./documents": {
      "types": "./dist/fetchDocument.d.ts",
      "default": "./dist/fetchDocument.js"
    },
    "./browsingSite": {
      "types": "./dist/browsingSite.d.ts",
      "default": "./dist/browsingSite.js"
    }
  },
  "dependencies": {
    "@once/collectors": "*",
    "@once/core": "*",
    "tldts": "^7.4.18"
  }
}
