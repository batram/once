{
  "name": "once_sidepanel",
  "version": "0.0.7",
  "private": true,
  "description": "Once in firefox sidepanel",
  "main": "dist/main.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "b2": "webpack --config apps/firefox-extension/webpack/webpack.config.js",
    "b1": "webpack --config apps/firefox-extension/webpack/webpack.dev.config.js",
    "build-dev": "webpack --config apps/firefox-extension/webpack/webpack.dev.config.js",
    "check:types": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.js",
    "check": "npm run check:types && npm run check:boundaries && npm run build-dev",
    "webex": "web-ext build --source-dir ./apps/firefox-extension/dist"
  },
  "author": "",
  "devDependencies": {
    "@types/firefox-webext-browser": "",
    "@types/pouchdb": "^6.4.0",
    "@typescript-eslint/eslint-plugin": "^4.15.0",
    "@typescript-eslint/parser": "^4.15.0",
    "copy-webpack-plugin": "^11.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^7.20.0",
    "pouchdb-browser": "^8.0.1",
    "ts-loader": "^9.4.4",
    "typescript": "^4.9.5",
    "webextension-polyfill": "^0.10.0",
    "webpack": "^5.88.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "pouchdb-browser": "^8.0.1"
  }
}
