{
  "manifest_version": 2,
  "name": "Once content probe fixture",
  "version": "1.0.0",
  "browser_specific_settings": { "gecko": { "id": "content-probe@once.test" } },
  "background": { "scripts": ["background.js"] },
  "permissions": ["tabs", "<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
