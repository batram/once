# Copy to .env.android.local for optional deployment overrides.
# Exported environment variables take precedence over this file.

# Wireless address: exported value > mDNS > connected wireless device > file.
# Use the address under Android Settings > Developer options > Wireless debugging.
# ONCE_ANDROID_WIRELESS_ADDRESS=192.168.1.50:5555

# Optional explicit ADB serial (including USB); --target overrides this setting.
# ONCE_ANDROID_SERIAL=your-device-serial

# auto builds only the connected device's preferred supported ABI.
# Alternatives: all, arm64-v8a, x86_64, or arm64-v8a,x86_64.
ONCE_ANDROID_DEPLOY_ABIS=auto

# push uses ADB's compressed file transfer before installing.
# Alternatives: streaming, fastdeploy (patch update, falls back to push on failure).
ONCE_ANDROID_INSTALL_MODE=push

# Reuse Gradle for faster repeat builds; false restores --no-daemon.
ONCE_ANDROID_GRADLE_DAEMON=true
