{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Once add-on manifest",
  "description": "Editor assistance for protocol 1. Run scripts/validate-addon.js for authoritative semantic validation.",
  "type": "object",
  "required": ["protocol", "id", "name", "version"],
  "properties": {
    "protocol": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "script": {
      "oneOf": [
        { "type": "string", "description": "Package-relative filename for ZIP/folder imports and linked directories" },
        { "type": "object", "required": ["file"], "properties": { "file": { "type": "string" } }, "additionalProperties": false },
        { "type": "object", "required": ["url", "integrity"], "properties": {
          "url": { "type": "string" },
          "integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/]{43}=$" }
        } }
      ]
    },
    "capabilities": { "type": "array", "items": { "type": "string", "pattern": "^fetch:" } },
    "settings": { "$ref": "#/$defs/settingsSchema" },
    "trays": { "type": "array", "maxItems": 4, "items": { "type": "object", "required": ["id", "title"], "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$" }, "title": { "type": "string", "maxLength": 60 }
    } } },
    "connections": { "type": "array", "maxItems": 8, "items": { "type": "object", "required": ["id", "endpoint"], "properties": {
      "id": { "type": "string" }, "endpoint": { "type": "string", "description": "Name of a URL setting" },
      "secret": { "type": "string", "description": "Name of a device-local secret setting" }, "auth": { "enum": ["bearer", "x-api-key"] }
    } } },
    "contributions": { "type": "array", "items": { "$ref": "#/$defs/contribution" } },
    "collectors": { "type": "array", "items": { "type": "object", "required": ["id", "type", "description", "collects"], "properties": {
      "id": { "type": "string" }, "type": { "type": "string", "pattern": "^[A-Za-z0-9]{2,4}$" },
      "description": { "type": "string" }, "collects": { "enum": ["dom", "json", "xml"] },
      "pattern": { "type": "array", "items": { "type": "string" } }, "config": { "type": "object" }
    } } },
    "panelActions": { "type": "array", "maxItems": 4, "items": { "type": "object", "required": ["id", "label", "run"] } }
  },
  "$defs": {
    "settingsSchema": { "type": "object", "properties": {
      "type": { "enum": ["object", "string", "number", "boolean", "array"] },
      "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/settingsSchema" } },
      "label": { "type": "string" }, "description": { "type": "string" }, "group": { "type": "string" },
      "format": { "enum": ["url", "multiline", "secret"] }, "maxLength": { "type": "integer", "maximum": 16000 },
      "visibleWhen": { "type": "object", "required": ["field", "equals"], "properties": {
        "field": { "type": "string" }, "equals": { "type": ["string", "boolean"] }
      } }
    } },
    "contribution": { "type": "object", "required": ["kind", "id"], "properties": {
      "kind": { "enum": ["action", "badge", "line"] }, "id": { "type": "string" },
      "label": { "type": "string" }, "icon": { "type": "string" },
      "text": { "type": "string" }, "compute": { "type": "string" },
      "when": { "type": "object" }, "run": { "type": "object" },
      "surfaces": { "type": "array", "items": { "enum": ["button", "menu", "swipe", "key"] } }
    } }
  }
}
