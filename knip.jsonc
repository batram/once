{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    // Ambient browser.* declarations are loaded by the root TypeScript graph.
    "@types/firefox-webext-browser",
    // Webpack resolves this loader from string-valued rules in extension,
    // Electron, and mobile configs rather than from JavaScript imports.
    "ts-loader"
  ],
  "ignoreIssues": {
    // TypeScript expands this wildcard to every visible ambient @types package;
    // it is compiler configuration, not a module import. Removing
    // `types: ["*"]` was tried and fails type-checking: ambient PouchDB,
    // Firefox `browser`, and NodeJS declarations depend on it.
    "tsconfig.base.json": ["unresolved"]
  },
  // Automatic Webpack config loading is disabled everywhere. The shared
  // extension config requires `--env target=chrome|firefox`, and loading it
  // without that aborts graph discovery. The cost is that each Webpack config
  // must be listed as an explicit entry below; Knip then emits a non-error
  // hint calling some of those entries redundant. Keep them anyway — removing
  // one makes that config file itself report as unused.
  "webpack": false,
  // Fixture WebExtensions are loaded by the Electron runtime at test time,
  // not imported by any module.
  "ignore": ["tests/fixtures/extensions/**"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.js",
        "tests/**/*.config.js",
        "tests/**/*.spec.js",
        "tests/**/*.test.js",
        "tests/e2e/electron/story-list.debug.js",
        "tests/e2e/mobile/*.js",
        "tests/mobile-env/server.js"
      ],
      "project": [
        "scripts/**/*.{js,mjs,cjs}",
        "tests/**/*.{js,mjs,cjs,ts,tsx}"
      ]
    },
    "apps/chrome-extension": {
      "entry": ["src/background.ts"],
      "project": ["src/**/*.ts"],
      "webpack": false
    },
    "apps/electron": {
      "ignoreDependencies": [
        // run-forge.js resolves the Forge CLI by path so it can use the pinned
        // Node runtime consistently on Windows.
        "@electron-forge/cli",
        // Forge loads makers by the package names declared in forge.config.js.
        "@electron-forge/maker-squirrel",
        "@electron-forge/maker-zip",
        // Webpack resolves stylesheet loaders from string-valued rules.
        "css-loader",
        "style-loader"
      ],
      "entry": [
        "src/main.ts",
        "src/preload.ts",
        "src/renderer.ts",
        "src/addonSandbox.ts",
        "src/pickerInjection.ts",
        "src/extensions/extensionPreload.ts",
        "src/extensions/contentPreload.ts",
        "forge.config.js",
        "webpack.*.config.js",
        "scripts/*.js"
      ],
      "project": ["src/**/*.ts", "*.js", "scripts/*.js"],
      "webpack": false
    },
    "apps/firefox-extension": {
      "entry": ["src/background.ts"],
      "project": ["src/**/*.ts"],
      "webpack": false
    },
    "apps/mobile": {
      "ignoreDependencies": [
        // Capacitor sync links these app-owned native plugins into the
        // generated Android and iOS projects.
        "@capacitor/browser",
        "@capacitor/splash-screen",
        "@capacitor/status-bar",
        // The root native E2E runner invokes the workspace-owned WDIO/Appium
        // CLI; WDIO then loads its service, runner, framework, reporter, and
        // platform drivers from configuration names at runtime.
        "@wdio/appium-service",
        "@wdio/cli",
        "@wdio/local-runner",
        "@wdio/mocha-framework",
        "@wdio/spec-reporter",
        "appium",
        "appium-uiautomator2-driver",
        "appium-xcuitest-driver",
        "webdriverio"
      ],
      "entry": [
        "src/main.ts",
        "src/pickerInjection.ts",
        "src/readerRuntime.ts",
        "webpack.config.js",
        "scripts/*.js"
      ],
      "project": ["src/**/*.ts", "*.ts", "*.js", "scripts/*.js"],
      "webpack": false
    },
    "apps/website": {
      "entry": [],
      "project": []
    },
    "packages/app": {
      "includeEntryExports": true,
      "project": ["src/**/*.ts"]
    },
    "packages/collectors": {
      "includeEntryExports": true,
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "includeEntryExports": true,
      "project": ["src/**/*.ts"]
    },
    "packages/persistence": {
      "includeEntryExports": true,
      "project": ["src/**/*.ts"]
    },
    "packages/platform-electron": {
      "includeEntryExports": true,
      "project": ["src/**/*.ts"]
    },
    "packages/platform-mobile": {
      "includeEntryExports": true,
      "project": ["src/**/*.ts"]
    },
    "packages/platform-web": {
      "project": ["src/**/*.ts"]
    },
    "packages/platform-webext": {
      "includeEntryExports": true,
      "project": ["src/**/*.ts"]
    },
    "packages/ui-web": {
      "entry": [
        "src/picker/contentScript.ts",
        "src/reader/contentScript.ts"
      ],
      "includeEntryExports": true,
      "project": ["src/**/*.ts"]
    },
    "packages/webext-shell": {
      "entry": [
        "src/keyCommandBackground.ts",
        "src/pickerBackground.ts",
        "src/readerBackground.ts",
        "src/storyMenuBackground.ts"
      ],
      "includeEntryExports": true,
      "project": ["src/**/*.ts"]
    }
  }
}
