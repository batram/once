# Optional, machine-specific iOS settings. Copy this file to .env.ios.local;
# exported variables take precedence over it.

# The Xcode to build with, when xcode-select points at the Command Line Tools.
DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer

# The phone `deploy:mobile:ios` installs on: a target id from
# `npx cap run ios --list` in apps/mobile (a simulator UDID or a phone's
# hardware id).
ONCE_IOS_DEVICE=00008140-0000000000000000
