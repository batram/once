{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Once Sidepanel",
  "description": "Put once in your side panel",
  "version": "0.0.7",
  "icons": {
    "48": "static/imgs/icons/mipmap-mdpi/ic_launcher.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "history",
    "contextMenus",
    "clipboardWrite",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "static/sidepanel.html"
  },
  "sandbox": {
    "pages": ["static/addon-sandbox.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' blob:; connect-src 'none'; img-src 'none'; style-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "action": {
    "default_icon": {
      "48": "static/imgs/icons/mipmap-mdpi/ic_launcher.png"
    },
    "default_title": "Click to open panel"
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open the Once side panel"
    },
    "toggle-comments": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Switch between story and comments"
    }
  }
}
