{
  "name": "@once/mobile",
  "version": "0.2.0",
  "private": true,
  "description": "Capacitor mobile application for Once",
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production",
    "build:dev": "webpack --config webpack.config.js --mode development",
    "serve": "webpack serve --config webpack.config.js --mode development",
    "assets": "capacitor-assets generate --android --ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cap": "cap"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@once/app": "*",
    "@once/platform-mobile": "*",
    "@once/ui-web": "*"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "@wdio/appium-service": "9.29.1",
    "@wdio/cli": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "appium": "3.5.2",
    "appium-uiautomator2-driver": "^8.1.0",
    "appium-xcuitest-driver": "^11.17.7",
    "express": "4.21.2",
    "express-pouchdb": "4.2.0",
    "pouchdb": "9.0.0",
    "webdriverio": "9.29.1",
    "webpack-dev-server": "^5.2.2"
  }
}
