{
  "manifest_version": 2,
  "name": "Once surface bridge",
  "version": "1.0.0",
  "description": "Lets the Once app run its source picker inside the GeckoView browsing surface. Built into the app; not a user-facing extension.",
  "browser_specific_settings": { "gecko": { "id": "once-surface@zmarn.com" } },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "<all_urls>",
    "webRequest",
    "webRequestBlocking"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
